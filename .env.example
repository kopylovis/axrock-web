# Локальная сборка. На GitHub эти же значения задаются переменными репозитория
# с префиксом AXROCK_ — их подставляет workflow, файл .env туда не попадает.
#
# Префикс VITE_ обязателен для всего, что должно попасть в клиентский код:
# Vite прокидывает в бандл только такие переменные.

# Публичный адрес сайта — canonical, Open Graph, JSON-LD, sitemap.
VITE_PUBLIC_SITE_URL=https://axrock.band

# Базовый адрес Ktor API. Backend живёт на отдельном домене,
# поэтому URL абсолютный, а не относительный /api.
VITE_API_BASE_URL=https://api.monoroh.com/api/axrock

# Подпапка, из которой GitHub Pages отдаёт project-page: /<имя-репозитория>/.
# Со своим доменом сайт живёт в корне — переменную тогда убрать.
# VITE_BASE_PATH=/axrock-web/

# Закрыть черновой адрес от поисковиков. Нужны обе: первая правит robots.txt,
# вторая ставит мета-тег на каждой странице.
# SITE_NOINDEX=true
# VITE_SITE_NOINDEX=true

# Свой домен для GitHub Pages. Пока пусто — сайт отдаётся на github.io.
# SITE_CNAME=axrock.band
