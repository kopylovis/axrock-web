# Публичный адрес сайта — используется в canonical, Open Graph, JSON-LD и sitemap.
VITE_PUBLIC_SITE_URL=https://axrock.band

# Базовый адрес Ktor API. Backend живёт на отдельном домене,
# поэтому URL абсолютный, а не относительный /api.
VITE_API_BASE_URL=https://api.monoroh.com/api/axrock

# Свой домен для GitHub Pages. Пока пусто — сайт отдаётся на <username>.github.io.
# SITE_CNAME=axrock.band

# Закрыть черновой адрес от поисковиков.
# SITE_NOINDEX=true
